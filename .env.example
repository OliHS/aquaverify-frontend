# Local/synthetic only. Never use production values in this file.
# Never commit .env. Use .env.local for local-only configuration.
# Manage staging/production variables through approved Vercel/Supabase controls.
# Local, staging and production must use separate credentials.
# Never paste real tokens, passwords, keys or personal data here.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=local-anon-placeholder
SUPABASE_SERVICE_ROLE_KEY=local-service-role-placeholder
SUPABASE_SERVICE_KEY=local-legacy-service-placeholder

VITE_PLATFORM_URL=http://127.0.0.1:3000
PLATFORM_URL=http://127.0.0.1:3000
CORPORATE_SITE_URL=http://127.0.0.1:5173
VITE_WORDPRESS_URL=http://127.0.0.1:8080

VITE_COOKIE_POLICY_VERSION=local-draft
VITE_LEGAL_POLICY_VERSION=local-draft
LEGAL_POLICY_VERSION=local-draft

ALLOW_REMOTE_CMS_AUDIT=0
SMOKE_TIMEOUT_MS=5000
VERCEL_CLI_VERSION=local-placeholder

WORKFLOW_ADVISOR_CORE_SOURCE=./vendor/workflow-advisor-core
AQUATOOLS_CORE_SOURCE=./vendor/aquatools-core
AQUAVERIFY_NPM_CACHE=./.npm-cache
