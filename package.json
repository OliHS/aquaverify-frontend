{
  "name": "aquaverify-corporate-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cms:links:audit": "node scripts/audit-cms-links.js",
    "cms:links:fix": "node scripts/audit-cms-links.js --fix",
    "smoke:prod": "node scripts/smoke-corporate-platform.js",
    "check:local": "npm run cms:links:audit && npm run build",
    "check:prod": "npm run cms:links:audit && npm run smoke:prod",
    "check:release": "npm run check:local && npm audit --audit-level=high && npm run smoke:prod",
    "deploy:prod": "node scripts/deploy-production.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "@types/react-helmet": "^6.1.11",
    "@types/react-router-dom": "^5.3.3",
    "framer-motion": "^12.34.1",
    "lucide-react": "^0.566.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-globe.gl": "^2.37.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "dotenv": "^17.3.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
