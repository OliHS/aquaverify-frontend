{
  "name": "aquaverify-corporate-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-marketing-pages.js",
    "preview": "vite preview",
    "cms:links:audit": "node scripts/audit-cms-links.js",
    "cms:links:fix": "node scripts/audit-cms-links.js --fix",
    "cms:claims:audit": "node scripts/audit-cms-claims.js",
    "cms:assets:audit": "node scripts/audit-marketing-assets.js",
    "cms:marketing:audit": "node scripts/sync-marketing-cms-links.js",
    "cms:marketing:strict": "node scripts/sync-marketing-cms-links.js --strict",
    "cms:marketing:sync": "node scripts/sync-marketing-cms-links.js --sync",
    "product:assets:generate": "node scripts/generate-product-assets.js",
    "product:claims:matrix": "node scripts/generate-product-claims-validation.js",
    "claims:audit": "node scripts/audit-product-claims.js",
    "marketing:routes:audit": "node scripts/audit-marketing-routes.js",
    "marketing:faqs:audit": "node scripts/audit-marketing-faqs.js",
    "marketing:screenshots:audit": "node scripts/audit-marketing-screenshots.js",
    "seo:sitemap": "node scripts/generate-sitemap.js",
    "validate:resources": "node scripts/validate-resources.js",
    "validate:glossary-industries:source": "node scripts/validate-glossary-industries.js --source",
    "validate:glossary-industries:dist": "node scripts/validate-glossary-industries.js --dist",
    "validate:glossary-industries": "node scripts/validate-glossary-industries.js",
    "smoke:prod": "node scripts/smoke-corporate-platform.js",
    "check:static": "npm run validate:resources && npm run validate:glossary-industries:source && npm run claims:audit && npm run marketing:routes:audit && npm run marketing:faqs:audit && npm run seo:sitemap && npm run build && npm run validate:resources && npm run validate:glossary-industries:dist",
    "check:cms": "npm run cms:links:audit && npm run cms:marketing:strict && npm run cms:assets:audit && npm run cms:claims:audit",
    "check:local": "npm run check:static && npm run check:cms && npm run marketing:screenshots:audit",
    "check:prod": "npm run cms:links:audit && npm run cms:marketing:strict && npm run cms:claims:audit && npm run smoke:prod",
    "check:release": "npm run check:static && npm run check:cms && npm audit --audit-level=high && npm run smoke:prod",
    "deploy:prod": "node scripts/deploy-production.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "@types/react-helmet": "^6.1.11",
    "@types/react-router-dom": "^5.3.3",
    "framer-motion": "^12.34.1",
    "lucide-react": "^0.566.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-globe.gl": "^2.37.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "dotenv": "^17.3.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
